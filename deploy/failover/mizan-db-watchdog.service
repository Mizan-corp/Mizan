[Unit]
Description=Mizan database failover watchdog (promotes latitude's standby when homie is gone)
Documentation=https://github.com/mizan-corp/Mizan/blob/master/deploy/failover/README.md
After=docker.service k3s.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/sbin/mizan-db-watchdog.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
