# syntax=docker/dockerfile:1
# The four Mizan apps, built and served by one nginx (deploy/server/nginx.conf).
# Build from the repo root:  docker build -f deploy/server/Dockerfile.web .
# Each app builds with its committed frontend/.env.production.

FROM python:3.12-slim-bookworm AS sdk
COPY sdk/python /sdk
RUN pip wheel --no-deps --no-cache-dir --wheel-dir /out /sdk

FROM node:22-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY shared/frontend/package.json shared/frontend/
COPY system/frontend/package.json system/frontend/
COPY website/frontend/package.json website/frontend/
COPY owner/frontend/package.json owner/frontend/
COPY admin/frontend/package.json admin/frontend/
COPY installer/setup/package.json installer/setup/
RUN npm ci --no-audit --no-fund -w shared/frontend -w system/frontend -w website/frontend \
      -w owner/frontend -w admin/frontend --include-workspace-root
COPY shared/frontend shared/frontend
COPY system/frontend system/frontend
COPY website/frontend website/frontend
COPY owner/frontend owner/frontend
COPY admin/frontend admin/frontend
COPY --from=sdk /out website/frontend/public/sdk
RUN for app in system website owner admin; do npm run build -w $app/frontend || exit 1; done
# The website's text files also as .gz, served as they are (gzip_static): no compressing per request.
RUN find website/frontend/dist -type f \( -name '*.html' -o -name '*.js' -o -name '*.css' -o -name '*.svg' \
      -o -name '*.xml' -o -name '*.txt' -o -name '*.json' -o -name '*.webmanifest' \) -size +1k \
      -exec gzip -9 -k -n {} +

FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/server/nginx.conf /etc/nginx/conf.d/mizan.conf
COPY deploy/server/mizan-common.conf deploy/server/mizan-panel-headers.conf deploy/server/mizan-panels.conf /etc/nginx/
COPY --from=build /repo/website/frontend/dist /srv/web/website
COPY --from=build /repo/system/frontend/dist /srv/web/system
COPY --from=build /repo/owner/frontend/dist/owner /srv/web/panels/owner
COPY --from=build /repo/admin/frontend/dist/admin /srv/web/panels/admin
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /srv/web && \
    sed -i 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf
USER nginx
EXPOSE 8080
