{
  "name": "mizan",
  "private": true,
  "workspaces": [
    "system/core/frontend",
    "system/erp/frontend",
    "website/frontend",
    "owner/frontend",
    "admin/frontend",
    "installer/setup"
  ],
  "scripts": {
    "dev:system": "npm run dev -w system/erp/frontend",
    "dev:website": "npm run dev -w website/frontend",
    "dev:owner": "npm run dev -w owner/frontend",
    "dev:admin": "npm run dev -w admin/frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
