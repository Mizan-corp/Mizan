{
  "name": "@mizan/website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mizan website frontend: landing, signup, onboarding and docs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
    "build:spa": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "seo:plans": "node scripts/update-plans.mjs",
    "seo:og": "python3 scripts/og-images.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "^2.1.2",
    "@mizan/shared": "1.0.0",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "motion": "^14.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "beasties": "^0.3.5",
    "jsdom": "^30.1.3",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
