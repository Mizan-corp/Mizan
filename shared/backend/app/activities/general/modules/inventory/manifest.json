{
  "id": "inventory",
  "name": "إدارة المخزون والتوريد",
  "name_en": "Inventory & Supply",
  "activity": "general",
  "kind": "business",
  "target_business_types": [
    "retail",
    "supermarket",
    "wholesale",
    "restaurant",
    "pharmacy"
  ],
  "version": "3.0.0",
  "icon": "Boxes",
  "description": "تتبع الأرصدة اللحظية، إدارة الفروع والمستودعات، تسويات الجرد، وأوامر الشراء والتوريد.",
  "dependencies": [
    "core"
  ],
  "is_core": false,
  "settings_schema": [
    {
      "key": "prevent_negative_stock",
      "label": "منع البيع بالسالب (منع استنفاد الرصيد)",
      "type": "boolean",
      "default": true,
      "description": "حظر إتمام عمليات البيع أو الصرف إذا كان الرصيد المتاح في المخزن غير كافٍ."
    },
    {
      "key": "enable_reorder_alerts",
      "label": "تنبيهات انخفاض المخزون اللحظية",
      "type": "boolean",
      "default": true,
      "description": "إظهار شارة تحذيرية حمراء فور وصول رصيد أي صنف إلى حد إعادة الطلب."
    },
    {
      "key": "valuation_method",
      "label": "طريقة تقييم المخزون المعتمدة",
      "type": "select",
      "default": "average_cost",
      "options": [
        "average_cost",
        "fifo"
      ],
      "description": "طريقة حساب تكلفة البضاعة المباعة (متوسط التكلفة المرجح أو الوارد أولاً صادر أولاً)."
    }
  ],
  "permissions": [
    {
      "id": "inventory",
      "name": "المخزون والأصناف",
      "name_en": "Inventory and products"
    },
    {
      "id": "inventory:opening",
      "name": "الرصيد الافتتاحي للمخزون",
      "name_en": "Opening stock"
    }
  ],
  "screens": [
    {
      "id": "inventory.inventory",
      "path": "/inventory",
      "label": "المخزون والتقييم",
      "icon": "Boxes",
      "permission": "inventory"
    },
    {
      "id": "inventory.operations",
      "path": "/operations",
      "label": "العمليات المخزنية",
      "icon": "ArrowLeftRight",
      "permission": "operations"
    },
    {
      "id": "inventory.products",
      "path": "/products",
      "label": "المنتجات",
      "icon": "Package",
      "permission": "inventory"
    },
    {
      "id": "inventory.purchases",
      "path": "/purchases",
      "label": "المشتريات والتوريد",
      "icon": "Truck",
      "permission": "purchases"
    }
  ],
  "widgets": [
    {
      "id": "inventory.low_stock_count",
      "label": "الأصناف تحت حد الطلب",
      "label_en": "Items below reorder level",
      "permission": "inventory|purchases",
      "size": "s"
    },
    {
      "id": "inventory.low_stock",
      "label": "النواقص العاجلة",
      "label_en": "Urgent shortages",
      "permission": "inventory|purchases",
      "size": "m"
    }
  ],
  "variants": [
    "standard",
    "pharmacy"
  ],
  "forms": {
    "product": {
      "label": "المنتج",
      "fields": [
        {
          "key": "name",
          "label": "الاسم",
          "locked": true
        },
        {
          "key": "barcode",
          "label": "الباركود"
        },
        {
          "key": "unit",
          "label": "الوحدة"
        },
        {
          "key": "retail_price",
          "label": "سعر التجزئة",
          "locked": true
        },
        {
          "key": "wholesale_price",
          "label": "سعر الجملة"
        },
        {
          "key": "cost_price",
          "label": "التكلفة"
        },
        {
          "key": "subcategory_id",
          "label": "التصنيف"
        },
        {
          "key": "tax_code",
          "label": "ضريبة القيمة المضافة"
        }
      ]
    }
  }
}
