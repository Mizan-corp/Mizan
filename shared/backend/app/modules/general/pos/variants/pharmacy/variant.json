{
  "id": "pharmacy",
  "module": "pos",
  "status": "planned",
  "description": "Drug counter: search by scientific name, batch by expiry (FEFO), prescription required for flagged drugs.",
  "screens": {
    "checkout": "drug_counter"
  },
  "fields": {
    "sale": [
      {
        "key": "rx_number",
        "label": "رقم الروشتة",
        "label_en": "Prescription no.",
        "type": "text"
      },
      {
        "key": "doctor_name",
        "label": "الطبيب المعالج",
        "label_en": "Prescriber",
        "type": "text"
      },
      {
        "key": "doctor_license",
        "label": "رقم ترخيص الطبيب",
        "label_en": "Prescriber licence",
        "type": "text"
      },
      {
        "key": "patient_name",
        "label": "اسم المريض",
        "label_en": "Patient",
        "type": "text"
      },
      {
        "key": "patient_national_id",
        "label": "الرقم القومي للمريض",
        "label_en": "Patient national ID",
        "type": "text"
      }
    ],
    "sale_line": [
      {
        "key": "batch_number",
        "label": "التشغيلة",
        "label_en": "Batch",
        "type": "text",
        "readonly": true
      },
      {
        "key": "expiry_date",
        "label": "الصلاحية",
        "label_en": "Expiry",
        "type": "date",
        "readonly": true
      }
    ]
  },
  "uses": [
    "batches",
    "pharmacy"
  ],
  "terms": {
    "item": "دواء",
    "customer": "مريض"
  },
