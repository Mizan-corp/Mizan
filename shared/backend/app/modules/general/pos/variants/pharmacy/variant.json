    "sell_unit": "strip_or_box",
    "prescription_check": true
  },
  "permissions": [
    "pos.dispense_controlled"
  ],
  "templates": {
    "receipt": "shows batch and expiry"
  },
  "widgets": [
    "expiring_this_month"
  ]
}
